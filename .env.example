# Front-end (exposed to the browser - never put secrets here)
VITE_LEDGER_ADDRESS=0xYourDeployedContractAddress
VITE_CHAIN_ID=11155111
VITE_EXPLORER_URL=https://sepolia.etherscan.io
# Optional: GIF previews. Without a key, a generated gradient avatar is used.
VITE_GIPHY_KEY=
# Set to true to run the UI with sample data and no wallet
VITE_DEMO=false

# Deployment script only (server side / local machine - NEVER commit the real file)
RPC_URL=https://sepolia.example-rpc.io/v2/YOUR_KEY
DEPLOYER_KEY=0xYOUR_TEST_ACCOUNT_PRIVATE_KEY
